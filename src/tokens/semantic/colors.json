			},
			"border": {
				"default": { "$type": "color", "$value": "{color.steel.200}" },
				"subtle": { "$type": "color", "$value": "{color.steel.100}" },
				"strong": { "$type": "color", "$value": "{color.steel.300}" },
				"muted": { "$type": "color", "$value": "{color.steel.400}" }
			},
			"feedback": {
				"success": { "$type": "color", "$value": "{color.sage.500}" },
